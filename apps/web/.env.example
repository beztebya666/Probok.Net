# Public URL of edge-api. HTTPS is mandatory outside local development.
NEXT_PUBLIC_EDGE_API_BASE_URL=http://localhost:8080

# Restricted Yandex JavaScript API browser key. Restrict it by allowed origins.
# Never put the Yandex Router/server API key here.
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# Fixture mode is opt-in and must remain false in production.
NEXT_PUBLIC_DEMO_MODE=false
