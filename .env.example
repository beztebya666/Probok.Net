# Local profile is intentionally usable without provider credentials.
APP_ENV=local
LOG_LEVEL=info
EDGE_ADDR=:8080
ORCHESTRATOR_ADDR=:8081
PROVIDER_ADDR=:8082
ORCHESTRATOR_URL=http://routing-orchestrator:8081
PROVIDER_URL=http://provider-yandex:8082
PUBLIC_EDGE_URL=http://localhost:8080
INTERNAL_API_TOKEN=local-dev-internal-token-change-before-sharing
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgres://greenroute:greenroute_local_only@postgres:5432/greenroute?sslmode=disable
REQUIRE_REDIS=false
REQUIRE_DATABASE=false
AUDIT_HASH_KEY=local-dev-audit-hash-key-change-before-sharing

# Local-only access. Production values override this to false and configure OIDC.
ENABLE_ANONYMOUS_USAGE=true
ENABLE_LOCAL_ANONYMOUS_ADMIN=true
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_ADMIN_GROUP=greenroute-admins
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUSTED_PROXY_CIDRS=

# Provider. Never prefix the server key with NEXT_PUBLIC_.
PROVIDER_MODE=stub
ADDRESS_PROVIDER_MODE=auto
YANDEX_ROUTER_API_KEY=
YANDEX_GEOCODER_API_KEY=
# Optional reserved autocomplete product; coordinates still come from the configured geocoder.
YANDEX_GEOSUGGEST_API_KEY=
DGIS_API_KEY=
DGIS_ROUTING_BASE_URL=https://routing.api.2gis.com
DGIS_MAX_RESULTS=3
# Current demo subscription guardrails; keep these aligned with 2GIS Platform Manager.
DGIS_RATE_LIMIT_PER_MINUTE=12

# 2GIS MapGL style used by the dark theme. Empty uses the public "Dark theme
# MapGL JS API" style from https://styles.2gis.com/. Paste your own style id
# from the Style Editor to change it, or set "off" to keep the map light.
NEXT_PUBLIC_2GIS_MAPGL_DARK_STYLE_ID=
DGIS_MONTHLY_LIMIT=1000
DGIS_GEOCODER_RATE_LIMIT_PER_MINUTE=600
# Ranking hint only (not a geographic filter), lon,lat. Moscow product default.
DGIS_GEOCODER_LOCATION_BIAS=37.617635,55.755814
YANDEX_ROUTER_BASE_URL=https://api.routing.yandex.net
YANDEX_GEOCODER_BASE_URL=https://geocode-maps.yandex.ru
ALLOW_EXPERIMENTAL_PROVIDER_SOURCES=false
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
GREENROUTE_YANDEX_TRAFFIC_AVAILABLE=false
# Operations console. Reaching /admin and listing it in the header are separate
# decisions, and both are off by default.
# When a route uses a toll road, spend one extra provider request on the same
# trip without tolls so the two can be compared. Off saves quota.
ENABLE_TOLL_FREE_PROBE=true
GREENROUTE_ADMIN_ENABLED=false
GREENROUTE_ADMIN_IN_MENU=false
# Origin-restricted browser MapGL key. Always use a separate key outside localhost.
NEXT_PUBLIC_2GIS_MAPGL_API_KEY=
# Legacy local alias; the localhost launcher can finally fall back to DGIS_API_KEY for preview only.
TWO_GIS_API_KEY=
NEXT_PUBLIC_EDGE_API_URL=http://localhost:8080

# License-gated data behavior is fail-closed.
PROVIDER_DATA_STORAGE_ALLOWED=false
PROVIDER_DATA_MODIFICATION_ALLOWED=false
PROVIDER_RESPONSE_CACHE_TTL=0
ENABLE_PROVIDER_CACHE=false

# Product flags: expensive/experimental work is explicitly enabled per environment.
ENABLE_ENHANCED_SEARCH=true
ENABLE_AVOID_ZONE_GENERATION=true
ENABLE_CORRIDOR_ANCHORS=true
ENABLE_ROUTE_RERANKING=true
ENABLE_LIVE_REROUTING=false
ENABLE_ADMIN_DEBUG_DETAILS=false
SCORING_POLICY_FILE=

OTEL_SERVICE_NAME=greenroute
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_INSECURE=true
