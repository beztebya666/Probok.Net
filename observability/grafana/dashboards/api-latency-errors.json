      "id": 1,
      "targets": [{"expr": "histogram_quantile(0.50, sum by (le, route) (rate(http_server_request_duration_seconds_bucket{route=~\"/api/.*\"}[$__rate_interval])))", "legendFormat": "p50 {{route}}", "refId": "A"}, {"expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_server_request_duration_seconds_bucket{route=~\"/api/.*\"}[$__rate_interval])))", "legendFormat": "p95 {{route}}", "refId": "B"}, {"expr": "histogram_quantile(0.99, sum by (le, route) (rate(http_server_request_duration_seconds_bucket{route=~\"/api/.*\"}[$__rate_interval])))", "legendFormat": "p99 {{route}}", "refId": "C"}],
      "title": "Public API latency by stable route",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "targets": [{"expr": "sum by (status_code) (rate(http_server_requests_total{route=~\"/api/.*\"}[$__rate_interval]))", "legendFormat": "{{status_code}}", "refId": "A"}],
      "title": "Public API responses by status",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 0.01}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "id": 3,
      "targets": [{"expr": "sum(rate(http_server_requests_total{route=~\"/api/.*\",status_code=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_requests_total{route=~\"/api/.*\"}[$__rate_interval])), 0.000001)", "refId": "A"}],
      "title": "Unsuccessful route-search ratio",
      "type": "gauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
      "id": 4,
      "targets": [{"expr": "greenroute:initial_route_latency:p95_5m", "legendFormat": "actual", "refId": "A"}, {"expr": "vector(3)", "legendFormat": "SLO", "refId": "B"}],
      "title": "Initial response p95 vs SLO",
      "type": "timeseries"
    },
    {
