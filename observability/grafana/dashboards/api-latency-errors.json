      "options": {"dedupStrategy": "signature", "enableLogDetails": true, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true},
      "targets": [{"expr": "{service_name=\"edge-api\"} | json | level=~\"error|ERROR\"", "refId": "A"}],
      "title": "Recent edge errors",
      "type": "logs"
    }
