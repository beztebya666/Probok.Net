HTTP_ADDR=:8082
APP_ENV=development
# INTERNAL_API_TOKEN must be at least 32 characters in production.
PROVIDER_MODE=stub
# YANDEX_ROUTER_API_KEY is required only for PROVIDER_MODE=yandex. Never commit a value.
YANDEX_ROUTER_BASE_URL=https://api.routing.yandex.net
# A separately licensed Geocoder key is preferred. If omitted, the router key is
# used, but it works only when that key is entitled for the HTTP Geocoder package.
# YANDEX_GEOCODER_API_KEY=
YANDEX_GEOCODER_BASE_URL=https://geocode-maps.yandex.ru
YANDEX_MAX_RESULTS=3
PROVIDER_CONNECT_TIMEOUT=500ms
PROVIDER_REQUEST_TIMEOUT=2500ms
PROVIDER_RESPONSE_HEADER_TIMEOUT=2s
PROVIDER_MAX_RETRIES=2
PROVIDER_RETRY_BASE_DELAY=100ms
PROVIDER_RETRY_MAX_DELAY=1s
PROVIDER_MAX_CONCURRENCY=32
PROVIDER_BULKHEAD_WAIT_TIMEOUT=100ms
PROVIDER_CB_FAILURE_THRESHOLD=5
PROVIDER_CB_OPEN_DURATION=30s
PROVIDER_SHUTDOWN_TIMEOUT=10s
PROVIDER_MAX_REQUEST_BODY_BYTES=131072
PROVIDER_MAX_RESPONSE_BYTES=4194304
# Contract-specific cost per billed response in the deployment's accounting currency.
PROVIDER_COST_PER_BILLABLE_UNIT=0
PROVIDER_DATA_STORAGE_ALLOWED=false
PROVIDER_DATA_MODIFICATION_ALLOWED=false
ALLOW_EXPERIMENTAL_PROVIDER_SOURCES=false
PROVIDER_STUB_SCENARIO=normal
PROVIDER_STUB_DELAY=4s
